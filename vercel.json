{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/app/main.py"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/simulator",
      "destination": "/simulator.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    }
  ]
}
