# HomeResource Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application
APP_NAME=HomeResource
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=generate-a-secure-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# Default is local SQLite. In production with Docker or Postgres, use:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/homeresource
DATABASE_URL=sqlite:///./homeresource.db

# Security & CORS
# Comma-separated list of allowed origins. Do not use wildcard '*' in authenticated production.
BACKEND_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000"]

# Demo & Rate Limiting
DEMO_MODE=True
RATE_LIMIT_PER_MINUTE=60
